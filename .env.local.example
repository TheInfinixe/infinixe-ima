# Firebase Configuration (get these from Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# EmailJS Configuration (get these from the EmailJS dashboard)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_spanish_template_id
EMAILJS_TEMPLATE_ID_EN=your_english_template_id
EMAILJS_PUBLIC_KEY=your_public_key
# Private key (Account > General > API Keys). Required for server-side sends.
EMAILJS_PRIVATE_KEY=your_private_key

# Gmail SMTP (primary email route: sends the v2 results email + PDF attachment)
# GMAIL_USER: the Gmail / Google Workspace address used as sender (e.g. hello@infinixe.co)
GMAIL_USER=your_gmail_address
# GMAIL_APP_PASSWORD: an "App password" generated at myaccount.google.com > Security >
# 2-Step Verification > App passwords (NOT the normal account password).
# If these two vars are missing or the send fails, the API falls back to EmailJS.
GMAIL_APP_PASSWORD=your_gmail_app_password

# Base URL of the VSL page used in the email CTA. The API appends ?lvl=<level>&n=<firstName>.
# Defaults to https://infinixe-ima.vercel.app/vsl if unset.
NEXT_PUBLIC_VSL_URL=https://your-domain.com/vsl

# Stripe Payment Links (the buy buttons on /vsl and /vsl-b)
NEXT_PUBLIC_STRIPE_LINK_450=https://buy.stripe.com/your_450_link
NEXT_PUBLIC_STRIPE_LINK_350=https://buy.stripe.com/your_350_link

# VSL video + offer reveal (optional)
# YouTube video ID for the VSL (page shows a placeholder until set)
NEXT_PUBLIC_VSL_VIDEO_ID=
# Seconds before the offer/buy button appears (default 120)
NEXT_PUBLIC_VSL_CTA_DELAY=120
